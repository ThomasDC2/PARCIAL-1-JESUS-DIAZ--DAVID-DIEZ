<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial1.controller.ConsultaClienteController">
  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
  <Label text="Consulta de cliente y número perfecto" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
  <Label text="Número de teléfono"/><TextField fx:id="telefono" promptText="Escribe el teléfono del cliente"/>
  <HBox spacing="8"><Button text="Buscar cliente" onAction="#buscarCliente"/>
    <Button text="Verificar número perfecto" onAction="#verificarNumeroPerfecto"/></HBox>
  <TextArea fx:id="resultado" editable="false" prefRowCount="8" wrapText="true"/>
</VBox>
