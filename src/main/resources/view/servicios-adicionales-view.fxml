<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial1.controller.ServicioAdicionalController">
  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
  <Label text="Gestión de servicios adicionales" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
  <GridPane hgap="8" vgap="8">
    <Label text="Código" GridPane.rowIndex="0"/><TextField fx:id="codigo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
    <Label text="Nombre" GridPane.rowIndex="1"/><TextField fx:id="nombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    <Label text="Descripción" GridPane.rowIndex="2"/><TextField fx:id="descripcion" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    <Label text="Precio" GridPane.rowIndex="3"/><TextField fx:id="precio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    <Label text="Disponible (true/false)" GridPane.rowIndex="4"/><TextField fx:id="disponible" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
  </GridPane>
  <HBox spacing="8"><Button text="Registrar" onAction="#registrar"/><Button text="Buscar" onAction="#buscar"/>
    <Button text="Actualizar" onAction="#actualizar"/><Button text="Eliminar" onAction="#eliminar"/><Button text="Listar" onAction="#listar"/></HBox>
  <TextArea fx:id="resultado" editable="false" prefRowCount="6" wrapText="true"/>
</VBox>
