<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial1.controller.EmpresaController">
  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
  <Label text="Datos de RentCar" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
  <GridPane hgap="8" vgap="8">
    <Label text="NIT" GridPane.rowIndex="0"/><TextField fx:id="nit" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
    <Label text="Nombre comercial" GridPane.rowIndex="1"/><TextField fx:id="nombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    <Label text="Dirección" GridPane.rowIndex="2"/><TextField fx:id="direccion" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    <Label text="Teléfono" GridPane.rowIndex="3"/><TextField fx:id="telefono" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    <Label text="Correo" GridPane.rowIndex="4"/><TextField fx:id="correo" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    <Label text="Página web" GridPane.rowIndex="5"/><TextField fx:id="paginaWeb" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
  </GridPane>
  <HBox spacing="8"><Button text="Guardar" onAction="#guardar"/><Button text="Buscar" onAction="#buscar"/>
    <Button text="Actualizar" onAction="#actualizar"/><Button text="Listar" onAction="#listar"/></HBox>
  <TextArea fx:id="resultado" editable="false" prefRowCount="5" wrapText="true"/>
</VBox>
