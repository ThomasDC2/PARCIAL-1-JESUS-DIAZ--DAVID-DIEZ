<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial1.controller.ReporteIngresosController">
  <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
  <Label text="Reporte de ingresos por periodo" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
  <Label text="Fecha inicial"/><DatePicker fx:id="fechaInicio"/>
  <Label text="Fecha final"/><DatePicker fx:id="fechaFin"/>
  <Button text="Consultar ingresos" onAction="#consultarIngresos"/>
  <TextArea fx:id="resultado" editable="false" prefRowCount="8" wrapText="true"/>
</VBox>
