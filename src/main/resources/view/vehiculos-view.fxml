<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.poo.parcial1.controller.VehiculoController">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Gestión de vehículos" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <GridPane hgap="8" vgap="8">
        <Label text="Placa" GridPane.rowIndex="0"/><TextField fx:id="placa" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Marca" GridPane.rowIndex="1"/><TextField fx:id="marca" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Modelo" GridPane.rowIndex="2"/><TextField fx:id="modelo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Año" GridPane.rowIndex="3"/><TextField fx:id="anio" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Tipo" GridPane.rowIndex="4"/><TextField fx:id="tipo" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label text="Tarifa diaria" GridPane.rowIndex="5"/><TextField fx:id="tarifaDiaria" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
    </GridPane>
    <HBox spacing="8"><Button text="Registrar" onAction="#registrar"/><Button text="Buscar" onAction="#buscar"/>
        <Button text="Actualizar" onAction="#actualizar"/><Button text="Eliminar" onAction="#eliminar"/><Button text="Listar" onAction="#listar"/></HBox>
    <TextArea fx:id="resultado" editable="false" prefRowCount="6" wrapText="true"/>
</VBox>
